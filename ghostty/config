# Ghostty config converted from iTerm2 default.json

# Font
font-family = Monaco
font-size = 12
font-thicken = true
# iTerm2 'Non Ascii Font' (HackNFM-Regular 12) has no direct Ghostty equivalent

# Appearance / colors
background = #000000
unfocused-split-fill = #000000
foreground = #bbbbbb
cursor-color = #bbbbbb
cursor-text = #ffffff
selection-background = #b5d5ff
selection-foreground = #000000
# iTerm2 'Link Color' not directly supported; was #005cbb
palette = 0=#000000
palette = 1=#bb0000
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#0000bb
palette = 5=#bb00bb
palette = 6=#00bbbb
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

# Cursor
cursor-style = block
cursor-style-blink = false

# Window
window-width = 80
window-height = 25
unfocused-split-opacity = 0.5
# iTerm2 'Disable Window Resizing' has no direct Ghostty equivalent

# Terminal behavior
term = xterm-256color
working-directory = /Users/ishandhanani
window-inherit-working-directory = true
# iTerm2 'Unlimited Scrollback' approximated with a large byte limit
scrollback-limit = 100000000

# iTerm2 readline-style navigation key bindings
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
keybind = cmd+arrow_left=text:\x01
keybind = cmd+arrow_right=text:\x05
keybind = alt+backspace=esc:\x7f
keybind = cmd+backspace=text:\x15
keybind = alt+delete=esc:d
keybind = delete=text:\x04

# Unported iTerm2 settings (no Ghostty equivalent)
# - Visual Bell / Flashing Bell
# - Badge / Match highlight colors
# - Cursor shadow
