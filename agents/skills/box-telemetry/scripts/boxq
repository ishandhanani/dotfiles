#!/usr/bin/env python3
"""boxq -- compact Prometheus queries for the box-telemetry stack.

  boxq '<promql>'                 instant value(s) now
  boxq '<promql>' --range 2h      one line per series: first, min, max, last over the window (--step 60s)
  boxq --targets                  scrape jobs and their health
Env: PROM_URL (default http://localhost:9091)
"""
import json
import os
import sys
import time
import urllib.parse
import urllib.request

PROM = os.environ.get("PROM_URL", "http://localhost:9091")
UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def get(path, **params):
    url = f"{PROM}/api/v1/{path}?{urllib.parse.urlencode(params)}"
    with urllib.request.urlopen(url, timeout=10) as r:
        d = json.load(r)
    if d["status"] != "success":
        sys.exit(f"prometheus: {d.get('error')}")
    return d["data"]


def labels(m):
    return ",".join(f"{k}={v}" for k, v in sorted(m.items()) if k != "__name__") or m.get("__name__", "")


def dur(s):
    return int(float(s[:-1]) * UNITS[s[-1]]) if s[-1] in UNITS else int(s)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return
    if argv[0] == "--targets":
        for t in sorted(get("targets")["activeTargets"], key=lambda t: t["labels"].get("job", "")):
            extra = t["labels"].get("resolver") or t["labels"].get("site") or ""
            err = (t.get("lastError") or "")[:70]
            print(f"{t['labels'].get('job',''):16s} {extra:14s} {t['health']:5s} {err}")
        return
    q = argv[0]
    if "--range" in argv:
        win = dur(argv[argv.index("--range") + 1])
        step = dur(argv[argv.index("--step") + 1]) if "--step" in argv else max(15, win // 240)
        now = int(time.time())
        res = get("query_range", query=q, start=now - win, end=now, step=step)["result"]
        if not res:
            print("(no series)"); return
        print(f"{'series':50s} {'first':>10s} {'min':>10s} {'max':>10s} {'last':>10s}  flips")
        for s in res:
            vals = [float(v) for _, v in s["values"]]
            flips = sum(1 for a, b in zip(vals, vals[1:]) if a != b)
            print(f"{labels(s['metric'])[:50]:50s} {vals[0]:10.4g} {min(vals):10.4g} {max(vals):10.4g} {vals[-1]:10.4g}  {flips}")
        return
    res = get("query", query=q)["result"]
    if not res:
        print("(no result)"); return
    for s in res:
        v = s["value"][1] if "value" in s else s["values"][-1][1]
        print(f"{labels(s['metric'])[:70]:70s} {v}")


if __name__ == "__main__":
    main(sys.argv[1:])
